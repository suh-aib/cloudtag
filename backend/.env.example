APP_NAME=CloudTag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cloudtag
MYSQL_USER=cloudtag
MYSQL_PASSWORD=yourpasswordhere
FRONTEND_URL=http://localhost:5173

ENTRA_CLIENT_ID=your-client-id
ENTRA_TENANT_ID=your-tenant-id
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Local Authentication
AUTH_MODE=entra
CLOUDTAG_LOCAL_ADMIN_USERNAME=cloudtag.suhaib
CLOUDTAG_LOCAL_ADMIN_PASSWORD=<set-locally>
LOCAL_AUTH_SECRET_KEY=local-dev-secret-key
